# tamago.conf — project agent configuration (TOML format)
# Copy to <project>/.tamago/tamago.conf and edit to match your setup.
#
# Run `tamago install` from the project root after creating this file.
# tamago will auto-detect it — no --config flag needed.

# ── Profile ────────────────────────────────────────────────────────────────────
# Exactly one [[profiles]] entry is supported.
# name  — profile directory name under your profile repo  (required)
# repo  — absolute path or git URL to the profile repo    (optional)
#         If omitted, tamago looks for the profile under ~/.tamago/<name>-profile
#         or under the tamago repo itself.

[[profiles]]
name = "hammer.mei"
# repo = "/Users/yourname/.tamago/hammer.mei-profile"   # local path
# repo = "git@github.com:you/hammer.mei-profile.git"    # git URL

# ── Agents ─────────────────────────────────────────────────────────────────────
# Agents to install into this project.
# name    — agent name (must match a persona file in the profile)
# source  — "profile" (from profile repo) or "tamago" (built-in)  [default: tamago]
# scope   — "project" → .claude/agents/ inside this project        [default: project]
#            "global"  → ~/.claude/agents/ so the agent is available
#                        from any Claude Code session on this machine.
#                        Memory dirs are still set up at project level.
# tts     — generate TTS-enabled agent file                        [default: true]
# memory  — wire up agent-memory symlinks                          [default: true]
# disable — set to true to prevent installation and remove any
#            existing file for this agent                          [default: false]

[[agents]]
name   = "hammer.mei"
source = "profile"
scope  = "global"   # install to ~/.claude/agents/ — available from every project
tts    = true
memory = true

# Example: opt out of a built-in tamago agent
# [[agents]]
# name    = "code-reviewer"
# disable = true

# ── Skills ─────────────────────────────────────────────────────────────────────
# Skills to symlink into this project.
# name    — skill directory name
# source  — "tamago" (built-in) or "profile" (from profile/skills/) [default: tamago]
# scope   — "global"  → ~/.claude/skills/ (accessible from any project) [default: global]
#            "project" → .claude/skills/ inside this project only
# path    — override path (for source = "url" skills)                [optional]
# disable — set to true to prevent installation and remove any
#            existing symlink for this skill                         [default: false]
#
# Built-in (tamago) and profile skills are global by default — no [[skills]] entry
# needed unless you want to opt out (disable = true) or keep a skill project-local
# (scope = "project").

# Example: keep a skill project-local instead of global
# [[skills]]
# name   = "text-to-speech"
# source = "tamago"
# scope  = "project"

# Example: opt out of a built-in tamago skill
# [[skills]]
# name    = "hatch"
# disable = true

# Example: URL-sourced external skill (always project-scoped for now)
# [[skills]]
# name   = "my-tool"
# source = "https://github.com/you/my-tool-skill.git"
# scope  = "project"

# ── Plugins ────────────────────────────────────────────────────────────────────
# Third-party tools that tamago provisions by calling their install.py.
# Plugin contract: <repo>/install.py {install,uninstall} --scope {global|project}
#                  [--project <project-dir>]   (only passed when scope = "project")
#
# name    — plugin identifier (for display only)
# repo    — path to the plugin repo (required, ~ is expanded)
# scope   — "global"  → no --project passed, hooks/skills installed globally
#            "project" → --project <current project> is passed              [default: global]
# disable — set to true to skip installation                                [default: false]

# Example: provision nagori from a git URL (tamago clones to ~/.tamago/repo-cache/)
# [[plugins]]
# name  = "nagori"
# repo  = "https://github.com/you/nagori.git"
# scope = "global"

# Example: provision nagori from a local checkout
# [[plugins]]
# name  = "nagori"
# repo  = "~/workspace/nagori"
# scope = "global"

# Example: provision a plugin for this project only
# [[plugins]]
# name  = "my-tool"
# repo  = "https://github.com/you/my-tool.git"
# scope = "project"

# ── Settings ───────────────────────────────────────────────────────────────────
# memory_sync — enable git-based memory sync across machines [default: true]
#               Set to false for offline/air-gapped setups.

[settings]
memory_sync = true
