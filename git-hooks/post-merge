#!/bin/bash
# tamago post-merge hook
# Automatically regenerates agent files after `git pull` on the tamago repo.
# Installed by: tamago install-global
#
# Iterates known-projects.json and runs `tamago install` for each project
# that has a .tamago/tamago.conf (TOML v2 format).

TAMAGO_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
KNOWN_PROJECTS="$HOME/.tamago/known-projects.json"

if [ ! -f "$KNOWN_PROJECTS" ]; then
  exit 0  # no known projects — nothing to do
fi

# Parse known-projects.json to get project paths
PROJECTS=$(python3 -c "
import json, sys
try:
    data = json.load(open(sys.argv[1]))
    for entry in data.get('projects', []):
        path = entry.get('path', '')
        if path:
            print(path)
except Exception as e:
    sys.exit(0)
" "$KNOWN_PROJECTS" 2>/dev/null)

if [ -z "$PROJECTS" ]; then
  exit 0
fi

echo "🥚 tamago updated — regenerating agent files..."

while IFS= read -r project_dir; do
  if [ -z "$project_dir" ]; then
    continue
  fi
  if [ ! -d "$project_dir" ]; then
    echo "🥚 skipping (not found): $project_dir" >&2
    continue
  fi
  conf="$project_dir/.tamago/tamago.conf"
  if [ ! -f "$conf" ]; then
    echo "🥚 skipping (no tamago.conf): $project_dir" >&2
    continue
  fi
  echo "🥚 reinstalling: $project_dir"
  cd "$project_dir" && python3 "$TAMAGO_DIR/setup.py" install
done <<< "$PROJECTS"
