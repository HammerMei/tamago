#!/bin/bash
# tamago post-merge hook
# Automatically regenerates merged agent files after `git pull` on tamago.
# Installed by: tamago install-global
#
# v2 path: if the project has .tamago/tamago.conf, use `tamago install`
#          (auto-detect).  Falls back to legacy local.conf + --profile-dir.

TAMAGO_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
LOCAL_CONF="$TAMAGO_DIR/local.conf"

if [ ! -f "$LOCAL_CONF" ]; then
  exit 0  # no local.conf = tamago not set up for a project yet, nothing to do
fi

PROFILE_REPO=$(grep "^PROFILE_REPO=" "$LOCAL_CONF" 2>/dev/null | cut -d= -f2-)
PROJECT_DIR=$(grep  "^PROJECT_DIR="  "$LOCAL_CONF" 2>/dev/null | cut -d= -f2-)

if [ -z "$PROJECT_DIR" ]; then
  exit 0
fi

if [ ! -d "$PROJECT_DIR" ]; then
  echo "🥚 tamago post-merge: PROJECT_DIR not found: $PROJECT_DIR" >&2
  exit 0
fi

echo "🥚 tamago updated — regenerating agent files..."

# v2: project has tamago.conf — use auto-detect path (no --profile needed)
if [ -f "$PROJECT_DIR/.tamago/tamago.conf" ]; then
  cd "$PROJECT_DIR" && python3 "$TAMAGO_DIR/setup.py" install
  exit $?
fi

# legacy: use PROFILE_REPO from local.conf
if [ -z "$PROFILE_REPO" ]; then
  echo "🥚 tamago post-merge: no PROFILE_REPO in local.conf and no tamago.conf found" >&2
  exit 0
fi

if [ ! -d "$PROFILE_REPO" ]; then
  echo "🥚 tamago post-merge: PROFILE_REPO not found: $PROFILE_REPO" >&2
  exit 0
fi

cd "$PROJECT_DIR" && python3 "$TAMAGO_DIR/setup.py" install --profile-dir "$PROFILE_REPO"
